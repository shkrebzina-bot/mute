odd_count = 0
even_count = 0
while True:
    num = int(input("Enter a number(0 to stop): "))
    if num == 0:
        break
    if num % 2 ==0:
        even_count += 1
    else:
        odd_count +=1
print("Odd number entered:", odd_count)
print("Even numbers entered:", even_count)



