blocks = int(input("Enter number of blocks: "))
layers = 0
used_blocks = 0
next_layer = 1
while used_blocks + next_layer <= blocks:
    used_blocks += next_layer
    layers += 1
    next_layer += 1
print("Number of layers:", layers)



Ush3
students = []
grades = []
while True:
    name = input("Enter student name (or 'stop' to finish):")
    if name.lower() == "stop":
        break
    grade = float(input("Enter grade: "))
    students.append(name)
    grades.append(grade)
print("\nAll student names:")
print(students)
print("\nAll grades:")
print(grades)
print("\nStudents with their grades:")
for i in range(len(students)):
    print(students[i], "-", grades[i])
ascending = sorted(grades)
descending = sorted(grades, reverse=True)
print("\nGrades ascending:")
print(ascending)
print("\nGrades descending:")
print(descending)




